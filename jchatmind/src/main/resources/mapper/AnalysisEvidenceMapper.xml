<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kama.jchatmind.mapper.AnalysisEvidenceMapper">

    <resultMap id="BaseResultMap" type="com.kama.jchatmind.model.entity.AnalysisEvidence">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="runId" column="run_id" jdbcType="VARCHAR"/>
        <result property="evidenceType" column="evidence_type" jdbcType="VARCHAR"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="score" column="score" jdbcType="DOUBLE"/>
        <result property="metadata" column="metadata" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.kama.jchatmind.model.entity.AnalysisEvidence"
            keyColumn="id" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO analysis_evidence
        (
            run_id,
            evidence_type,
            title,
            content,
            score,
            metadata,
            created_at,
            updated_at
        )
        VALUES
        (
            CAST(#{runId} AS uuid),
            #{evidenceType},
            #{title},
            #{content},
            #{score},
            CAST(#{metadata} AS jsonb),
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <select id="selectByRunId" resultMap="BaseResultMap">
        SELECT id, run_id, evidence_type, title, content, score, metadata::text AS metadata,
               created_at, updated_at
        FROM analysis_evidence
        WHERE run_id = CAST(#{runId} AS uuid)
        ORDER BY created_at ASC
    </select>
</mapper>
